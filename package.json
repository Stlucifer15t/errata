{
  "name": "errata",
  "version": "1.12.0",
  "private": true,
  "license": "GPL-2.0",
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "bun install --frozen-lockfile && vite dev --port 7739",
    "dev:share": "bun install --frozen-lockfile && bun scripts/proxy-with-qr.mjs",
    "build": "bun install --frozen-lockfile && vite build",
    "new:plugin": "bun scripts/new-plugin.mjs",
    "build:binary": "bun install --frozen-lockfile && bun scripts/build-binary.mjs",
    "package:binary": "bun scripts/package-binary.mjs",
    "release:binary": "bun run build:binary && bun run package:binary",
    "electron:dev": "bun scripts/electron-dev.mjs",
    "electron:pack": "bun install --frozen-lockfile && bun scripts/build-electron.mjs --dir",
    "electron:dist": "bun install --frozen-lockfile && bun scripts/build-electron.mjs",
    "electron:release": "bun install --frozen-lockfile && bun scripts/build-electron.mjs --publish=always",
    "stress:backend": "bun install --frozen-lockfile && bun scripts/backend-stress-harness.ts",
    "docs:sync": "bun scripts/sync-docs-from-commits.ts",
    "preview": "bun install --frozen-lockfile && vite preview",
    "test": "bun install --frozen-lockfile && vitest run --config vitest.config.ts",
    "test:watch": "bun install --frozen-lockfile && vitest --config vitest.config.ts",
    "android:assemble": "bun scripts/build-android.mjs",
    "android:open": "bun scripts/build-android.mjs && bunx cap open android",
    "android:apk": "bun scripts/build-android.mjs --apk"
  },
